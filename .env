# Flask
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=change-me

# Local ML recommender settings
SONG_RECOMMENDATION_LIMIT=10
LOCAL_SONGS_DATASET_PATH=data/local_songs.csv

# Local emotion model
EMOTION_MODEL_ENABLED=1
EMOTION_MODEL_PATH=model/emotion_model.pkl
EMOTION_MODEL_MIN_CONFIDENCE=0.50

# Local response retriever model
RESPONSE_MODEL_ENABLED=1
RESPONSE_MODEL_PATH=model/response_model.pkl

# Local song ranking model
SONG_MODEL_ENABLED=1
SONG_MODEL_PATH=model/song_model.pkl
